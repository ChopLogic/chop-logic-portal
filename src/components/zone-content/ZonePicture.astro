---
import type { DynamicZonePicture } from "@models";
import { Image } from "chop-logic-components";

interface Props {
	picture: DynamicZonePicture;
	className?: string;
}

const { picture, className } = Astro.props;
const { item, aspectRatio } = picture;
---

<section class="zone-picture">
	<Image {...item} className={className} aspectRatio={aspectRatio} />
</section>

<style>
	.zone-picture {
		width: 100%;
	}

	.zone-picture img {
		width: 100%;
	}
</style>