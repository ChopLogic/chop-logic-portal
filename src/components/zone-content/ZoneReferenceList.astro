---
import type { DynamicZoneReferenceList } from "@models";
import Link from "../link/Link.astro";
import ZoneHeadingBlock from "./ZoneHeadingBlock.astro";

interface Props {
	referenceList: DynamicZoneReferenceList;
}

const { referenceList } = Astro.props;
const { id, heading, subHeading, links } = referenceList;
---

<section
	class="zone-references"
>
	<ZoneHeadingBlock heading={heading} subHeading={subHeading} />
	{
		links.length > 0 ? (
			<ol class="zone-references-list">
				{links.map((link, index) => (
					<li
						id={`ref-${id}-${index + 1}`}
						class="zone-references-item"
					>
						<cite>
							<Link link={link} className="zone-references-link">
								{link.text}
							</Link>
						</cite>
					</li>
				))}
			</ol>
		) : (
			<p class="zone-references-empty">No references yet.</p>
		)
	}
</section>