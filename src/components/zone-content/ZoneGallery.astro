---
import { Gallery } from "chop-logic-components";
import type { DynamicZoneGallery } from "../../lib/content/models/dynamic-zone";
import { mapCMSImageToGalleryItem } from "./gallery";

interface Props {
	gallery: DynamicZoneGallery;
}

const { gallery } = Astro.props;
const { heading, subHeading, layout, items, aspectRatio } = gallery;

const galleryItems = items.map((image) =>
	mapCMSImageToGalleryItem(image, aspectRatio),
);
---

<section class:list={["zone-gallery", `zone-gallery--${layout}`]}>
	<h2>{heading}</h2>
	{subHeading && <h3>{subHeading}</h3>}
	<Gallery
		client:load
		images={galleryItems}
		layout={layout}
		enableFullscreen
	/>
</section>

<style>
	.zone-gallery {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--cl-l-gap);
	}
</style>
