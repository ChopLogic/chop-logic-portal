---
import type { DynamicZoneGallery } from "@models";
import { Gallery } from "chop-logic-components";

interface Props {
	gallery: DynamicZoneGallery;
}

const { gallery } = Astro.props;
const { heading, subHeading, layout, items } = gallery;
---

<section class:list={["zone-gallery", `zone-gallery--${layout}`]}>
	<h2>{heading}</h2>
	{subHeading && <h3>{subHeading}</h3>}
	<Gallery
		client:load
		images={items}
		layout={layout}
		enableFullscreen
	/>
</section>

<style>
	.zone-gallery {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--cl-l-gap);
	}
</style>
