---
import type { DynamicZoneCallToAction } from "@models";
import { Button } from "chop-logic-components";
import Link from "../link/Link.astro";
import Picture from "../picture/Picture.astro";
import { CMS_PICTURE_SIZES } from "../picture/Picture.helpers";
import ZoneHeadingBlock from "./ZoneHeadingBlock.astro";

interface Props {
	callToAction: DynamicZoneCallToAction;
}

const { callToAction } = Astro.props;
const { heading, subHeading, link, picture } = callToAction;
---

<section
	class:list={["zone-cta", { "zone-cta--with-media": Boolean(picture) }]}
>
	{
		picture && (
			<div class="zone-cta__media">
				<Picture item={picture} sizes={CMS_PICTURE_SIZES.cta} />
			</div>
		)
	}
	<ZoneHeadingBlock
		heading={heading}
		subHeading={subHeading}
		className="zone-cta__heading"
	/>
	<Link link={link} className="zone-cta__link">
		<Button text={link.text} extended />
	</Link>
</section>

<style>
	.zone-cta {
		display: grid;
		justify-items: center;
		grid-template-columns: auto;
		grid-template-areas:
			"heading"
			"button";
	}

	.zone-cta--with-media {
		grid-template-columns: 1fr;
		grid-row-gap: var(--cl-m-gap);
		grid-template-rows: auto;
		grid-template-areas:
			"media"
			"heading"
			"button";
	}

	:global(.zone-cta__heading) {
		grid-area: heading;
		width: 100%;
		text-align: center;
	}

	.zone-cta__media {
		grid-area: media;
	}

	:global(.zone-cta__link) {
		grid-area: button;
		width: 100%;
		display: inline-block;
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.zone-cta--with-media {
			justify-items: start;
			grid-row-gap: var(--cl-l-gap);
			grid-column-gap: var(--cl-xl-gap);
			grid-template-columns: 2fr 1fr;
			grid-template-rows: auto;
			grid-template-areas:
				"media heading"
				"media button"
				"media .";
		}

		:global(.zone-cta__heading) {
			text-align: left;
		}

		:global(.zone-cta__link) {
			width: fit-content;
		}
	}
</style>
