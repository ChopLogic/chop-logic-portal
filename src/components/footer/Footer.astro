---

import type { Link, RichTextContent } from "@models";
import RichTextBlockContent from "../rich-text/RichTextBlock.astro";
import SocialLinks from "./SocialLinks.astro";

interface Props {
	content: RichTextContent;
	links: Link[];
}

const { content, links } = Astro.props;
const hasSocialLinks = links.some((l) => l.platform);
---

<footer class="footer">
	<RichTextBlockContent content={content} />
	<a href="/privacy-policy" class="footer__privacy-link">Privacy Policy</a>
	{
		hasSocialLinks && (
			<div class="footer__social-links">
				<SocialLinks links={links} />
			</div>
		)
	}
</footer>
<style>
	.footer {
		padding: 2rem 2rem 6rem 2rem;
		background: linear-gradient(var(--cl-surface-a10), var(--cl-surface-a0)) no-repeat;
		text-align: center;
		color: var(--cl-base-font-color);
		font-family: var(--cl-core-font);
		font-size: var(--cl-typography-small-mobile);
		font-weight: normal;
		letter-spacing: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	.footer__social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}
	.footer__privacy-link {
		padding: 1em 0.5em;
		color: var(--cl-base-font-color);
		text-decoration: none;
		text-decoration: none;
	}
	.footer__privacy-link:hover {
		text-shadow: var(--cl-text-shadow);
		text-decoration: underline;
	}
	.footer__privacy-link.active {
		text-decoration: none;
		text-shadow: none;
		cursor: default;
		color: var(--cl-accent-a0);
	}

	@media (min-width: 640px) {
		.footer {
			font-size: var(--cl-typography-small-tablet);
		}
	}

	@media (min-width: 1024px) {
		.footer {
			font-size: var(--cl-typography-small-desktop);
		}
	}
</style>
