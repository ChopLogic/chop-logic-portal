---
import rawLogoSvg from "@assets/Chop-Logic-Logo-Head.svg?raw";
import { Settings } from "@components";
import HeaderLink from "./HeaderLink.astro";

// Each <path> ships with its own hardcoded fill;
// swap them for currentColor so the logo can be recolored per theme.
const logoSvg = rawLogoSvg.replaceAll(
	/fill="#[0-9a-fA-F]{3,6}"/g,
	'fill="currentColor"',
);
---

<header class="header">
	<div class="header__container">
		<div class="header__logo" set:html={logoSvg} />
		<nav class="header__navigation">
			<HeaderLink href="/" class="header__link">Home</HeaderLink>
			<HeaderLink href="/blog" class="header__link">Blog</HeaderLink>
			<HeaderLink href="/about" class="header__link">About</HeaderLink>
		</nav>
		<Settings client:load className="header__settings" />
	</div>
</header>
<style>
	.header {
		margin: 0;
		padding: 0;
		background: var(--cl-base-background-color);
		box-shadow: var(--cl-box-shadow);
	}
	.header__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--cl-xl-gap);
		max-width: 1200px;
		margin: 0 auto;
	}
	.header__navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.header__link {
		padding: 1em 0.5em;
		color: var(--cl-base-font-color);
		text-decoration: none;
	}
	.header__link:hover {
		text-shadow: var(--cl-text-shadow);
		text-decoration: underline;
	}
	.header__link.active {
		text-decoration: none;
		text-shadow: none;
		cursor: default;
		color: var(--cl-accent-a0);
	}
	.header__logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		color: var(--cl-base-font-color);
	}
	.header__logo :global(svg) {
		display: block;
		width: 48px;
		height: 48px;
	}
	:global(.header__settings) {
		padding: 0;
		display: flex;
		align-items: center;
	}
	@media (min-width: 640px) {
		.header__logo :global(svg) {
			width: 56px;
			height: 56px;
		}
	}
	@media (min-width: 1024px) {
		.header__logo :global(svg) {
			width: 64px;
			height: 64px;
		}
	}
</style>
