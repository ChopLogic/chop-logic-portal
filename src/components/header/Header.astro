---
import { ThemeSwitcher } from "@components";
import HeaderLink from "./HeaderLink.astro";
---

<header class="header">
	<nav class="header__navigation">
		<HeaderLink href="/" class="header__link">Home</HeaderLink>
		<HeaderLink href="/blog" class="header__link">Blog</HeaderLink>
		<HeaderLink href="/about" class="header__link">About</HeaderLink>
	</nav>
	<ThemeSwitcher client:load className="header__theme-switcher" />
</header>
<style>
	.header {
		margin: 0;
		padding: 0;
		background: var(--cl-base-background-color);
		box-shadow: var(--cl-box-shadow);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.header__navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.header__link {
		padding: 1em 0.5em;
		color: var(--cl-base-font-color);
		text-decoration: none;
	}
	.header__link:hover {
		text-shadow: var(--cl-text-shadow);
		text-decoration: underline;
	}
	.header__link.active {
		text-decoration: none;
		text-shadow: none;
		cursor: default;
		color: var(--cl-accent-a0);
	}
	:global(.header__theme-switcher) {
		margin-right: var(--cl-l-gap);
	}
</style>
