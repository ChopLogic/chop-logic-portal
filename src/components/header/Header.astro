---
import { Settings } from "@components";
import HeaderLink from "./HeaderLink.astro";
---

<header class="header">
	<div class="header__container">
		<div class="header__logo"></div>
		<nav class="header__navigation">
			<HeaderLink href="/" class="header__link">Home</HeaderLink>
			<HeaderLink href="/blog" class="header__link">Blog</HeaderLink>
			<HeaderLink href="/about" class="header__link">About</HeaderLink>
		</nav>
		<Settings client:load className="header__settings" />
	</div>
</header>
<style>
	.header {
		margin: 0;
		padding: 0;
		background: var(--cl-base-background-color);
		box-shadow: var(--cl-box-shadow);
	}
	.header__container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--cl-xl-gap);
		max-width: 1200px;
		margin: 0 auto;
	}
	.header__navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.header__link {
		padding: 1em 0.5em;
		color: var(--cl-base-font-color);
		text-decoration: none;
	}
	.header__link:hover {
		text-shadow: var(--cl-text-shadow);
		text-decoration: underline;
	}
	.header__link.active {
		text-decoration: none;
		text-shadow: none;
		cursor: default;
		color: var(--cl-accent-a0);
	}
	.header__logo {
		min-width: 70px;
		min-height: 70px;
		background: var(--cl-accent-a0);
	}
</style>
