---
import type { ArticlePreview } from "@models";
import { PreviewCard } from "chop-logic-components";

type Props = {
	previews: ArticlePreview[];
};

const { previews } = Astro.props;
---

<div class="articles-gallery">
	{
		previews.map(({ slug, ...rest }) => {
			return (
				<PreviewCard
					link={`/blog/${slug}`}
					{...rest}
					className="articles-gallery__summary"
				/>
			);
		})
	}
</div>
<style>
	.articles-gallery {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: auto;
		gap: var(--cl-l-gap);
		padding-top: var(--cl-xl-gap);
	}

	.articles-gallery__summary {
		width: auto;
		min-width: 0;
		min-height: 0;
	}

	@media (min-width: 640px) {
		.articles-gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.articles-gallery {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
