---
import { type ImageProps, PreviewCard } from "chop-logic-components";
import { DEFAULT_ALT_TEXT } from "../../constants/defaults";
import type { ArticleSummary } from "../../lib/content/models";

type Props = {
	summaries: ArticleSummary[];
};

const { summaries } = Astro.props;
---

<div class="summaries-grid">
	{
		summaries.map((summaries) => {
			const image: ImageProps = {
				src: summaries.preview?.url ?? "",
				alt: summaries.preview?.alternativeText ?? DEFAULT_ALT_TEXT,
				aspectRatio: "16/9",
			};

			return (
				<PreviewCard
					link={`/blog/${summaries.slug}`}
					title={summaries.title}
					image={image}
					authors={[]}
					tags={[]}
					summary={summaries.excerpt}
					className="summaries-grid__summary"
				/>
			);
		})
	}
</div>
<style>
	.summaries-grid {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: auto;
		gap: var(--cl-l-gap);
		
	}

	.summaries-grid__summary {
		width: auto;
		min-width: 0;
		min-height: 0;
	}

	@media (min-width: 640px) {
		.summaries-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.summaries-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
