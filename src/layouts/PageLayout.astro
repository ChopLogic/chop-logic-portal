---
import {
	FooterComponent,
	HeaderComponent,
	MetaDataComponent,
	ScrollToTopButton,
} from "@components";
import { THEME_STORAGE_KEY } from "@constants";
import type { CorePageData, MetaData } from "@models";
import {
	CL_DARK_THEME_CLASS,
	CL_LIGHT_THEME_CLASS,
} from "chop-logic-components";

type Props = Omit<CorePageData, "logo"> & {
	readonly siteUrl: string;
	readonly metaData: MetaData;
};

const { siteTitle, footer, links, metaData, siteUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<script
			is:inline
			define:vars={{
				storageKey: THEME_STORAGE_KEY,
				lightClass: CL_LIGHT_THEME_CLASS,
				darkClass: CL_DARK_THEME_CLASS,
			}}
		>
			// Applied before first paint to avoid a light/dark flash on load.
			const storedTheme = localStorage.getItem(storageKey);
			const prefersDark = window.matchMedia(
				"(prefers-color-scheme: dark)",
			).matches;
			const isDark = storedTheme ? storedTheme === darkClass : prefersDark;
			document.documentElement.classList.add(isDark ? darkClass : lightClass);
		</script>
		<MetaDataComponent
			siteTitle={siteTitle}
			metaData={metaData}
			siteRoot={siteUrl}
		/>
	</head>
	<body>
		<HeaderComponent />
		<ScrollToTopButton client:load className="main-layout__scroll-to-top" />
		<main class="main-layout">
			<slot />
		</main>
		<FooterComponent content={footer} links={links} />
	</body>
</html>
<style>
	body {
		background: var(--cl-base-background-color);
	}

	.main-layout {
		padding: var(--cl-xl-gap);
		max-width: 1200px;
		margin: 0 auto;
	}

	:global(.main-layout__scroll-to-top) {
		position: fixed;
		bottom: var(--cl-l-gap);
		right: var(--cl-l-gap);
		z-index: var(--cl-z-index-modal);
		width: 46px;
		height: 46px;
		border-radius: 50%;
	}

	:global(.main-layout__scroll-to-top .cl-icon) {
		font-size: 46px;
	}

	:global(.main-layout__scroll-to-top .cl-icon::before) {
		color: var(--cl-surface-a30);
	}
</style>
