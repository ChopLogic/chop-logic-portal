---
import HeroBlock from "../components/hero-block/HeroBlock.astro";
import ZoneContent from "../components/zone-content/ZoneContent.astro";
import Layout from "../layouts/PageLayout.astro";
import { createContentProvider } from "../lib/content/provider";
import { PageService } from "../services";

const provider = createContentProvider();
const { home, siteConfig } = await provider.getHomePageContent();
const { siteTitle, footer, links } = siteConfig;
const { title, subTitle, content, metaData } = home;
const service = new PageService();
const homepage = await service.getArticlePageBySlug("article-4-test");
console.log("PAGE", homepage);
---

<Layout siteTitle={siteTitle} footer={footer} links={links} metaData={metaData}>
	<HeroBlock title={title} subTitle={subTitle} />
	<ZoneContent content={content} />
</Layout>
