---
import { StrapiGraphQLClient } from "@api/client";
import {
	ArticleSummary,
	HeroBlockComponent,
	ZoneContentComponent,
} from "@components";
import { PageLayout } from "@layouts";
import { ConfigService, PageService } from "@services";

export async function getStaticPaths() {
	const config = new ConfigService();
	const siteUrl = config.getSiteUrl();
	const apiUrl = config.getApiUrl();
	const client = new StrapiGraphQLClient({
		apiUrl,
		token: config.getApiToken(),
	});
	const service = new PageService(client, {
		apiUrl: config.getApiUrl(),
	});

	const slugs = await service.getArticleSlugs();

	const paths = await Promise.all(
		slugs.map(async (slug) => {
			const page = await service.getArticlePageBySlug(slug);
			return {
				params: { slug },
				props: { page, siteUrl },
			};
		}),
	);
	return paths.filter((p): p is NonNullable<typeof p> => p !== null);
}

const { page, siteUrl } = Astro.props;
const {
	siteTitle,
	footer,
	links,
	metaData,
	title,
	subTitle,
	content,
	summary,
	tags,
} = page;
---

<PageLayout
	siteTitle={siteTitle}
	footer={footer}
	links={links}
	metaData={metaData}
	siteUrl={siteUrl}
>
	<HeroBlockComponent title={title} subTitle={subTitle} />
	<ArticleSummary content={summary} tags={tags} />
	<ZoneContentComponent content={content} />
</PageLayout>
