---
import HeroBlock from "../../components/hero-block/HeroBlock.astro";
import ZoneContent from "../../components/zone-content/ZoneContent.astro";
import Layout from "../../layouts/PageLayout.astro";
import { ArticleNotFoundError } from "../../lib/content/errors";
import { createContentProvider } from "../../lib/content/provider";

export async function getStaticPaths() {
	const content = createContentProvider();
	const { articles } = await content.getBlogPageContent();
	const paths = await Promise.all(
		articles.map(async (item) => {
			try {
				const article = await content.getArticlePageBySlug(item.slug);
				return {
					params: { slug: item.slug },
					props: { article },
				};
			} catch (e) {
				if (e instanceof ArticleNotFoundError) {
					return null;
				}
				throw e;
			}
		}),
	);
	return paths.filter((p): p is NonNullable<typeof p> => p !== null);
}

const { article } = Astro.props;
const { page, siteConfig } = article;
const { siteTitle, footer, links } = siteConfig;
const { title, subTitle, content, metaData } = page;
---

<Layout siteTitle={siteTitle} footer={footer} links={links} metaData={metaData}>
	<HeroBlock title={title} subTitle={subTitle} />
	<ZoneContent content={content} />
</Layout>
