---
import { StrapiGraphQLClient } from "@api/client";
import ArticlesPreviewsGrid from "@components/articles-previews-grid/ArticlesPreviewsGrid.astro";
import HeroBlock from "@components/hero-block/HeroBlock.astro";
import ZoneContent from "@components/zone-content/ZoneContent.astro";
import Layout from "@layouts/PageLayout.astro";
import { ConfigService, PageService } from "@services";

const config = new ConfigService();
const client = new StrapiGraphQLClient({
	apiEndpoint: config.getApiUrl(),
	token: config.getApiToken(),
});
const service = new PageService(client, {
	siteUrl: config.getSiteUrl(),
	apiUrl: config.getApiUrl(),
});
const {
	siteTitle,
	footer,
	links,
	metaData,
	title,
	subTitle,
	content,
	previews,
} = await service.getBlogPage();
---

<Layout siteTitle={siteTitle} footer={footer} links={links} metaData={metaData}>
	<HeroBlock title={title} subTitle={subTitle} />
	<ZoneContent content={content} />
	<ArticlesPreviewsGrid previews={previews} />
</Layout>
